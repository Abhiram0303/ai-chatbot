# ==============================================================================
# NOVA AI ASSISTANT — BACKEND ENVIRONMENT VARIABLES (.env.example)
# ==============================================================================
# Copy this file to '.env' inside the backend/ folder.
# NEVER commit your actual API keys or secrets to Git!

# Google Gemini API Settings
# Obtain your API key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# Groq API Settings (Fallback and direct provider)
# Obtain your API key from Groq Console: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Server & Network Settings
PORT=8000
HOST=0.0.0.0
FRONTEND_URL=https://nova-ai-eight-alpha.vercel.app

# Provider Timeout (in seconds)
AI_PROVIDER_TIMEOUT_SECONDS=15

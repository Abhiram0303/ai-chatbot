# ==============================================================================
# AI CHATBOT - ENVIRONMENT VARIABLES CONFIGURATION (.env.example)
# ==============================================================================
# Copy this file to '.env' inside the backend folder or project root.
# NEVER commit your actual API keys to Git!

# Google Gemini API Settings (Backend)
# Get your API key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# Groq API Settings (Backend)
# Get your API key from Groq Console: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Server & Security Settings (Backend)
PORT=8000
HOST=127.0.0.1
FRONTEND_URL=http://localhost:5173

# Frontend Environment Variable (Vite requires VITE_ prefix)
VITE_API_BASE_URL=http://localhost:8000

# Firebase Configuration (Frontend)
# Get these values from Firebase Console → Project Settings → Web App
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abcdef
